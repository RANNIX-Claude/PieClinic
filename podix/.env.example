# Clínicas de Podología (podix) · variables de entorno. Copia a .env.local (ignorado por git) y llena SOLO para modo qa.
# Las tres VITE_SUPABASE_* / VITE_DB_SCHEMA son públicas por diseño (van en el bundle); la seguridad es RLS con la sesión.
# NUNCA pongas aquí la service_role, tokens de cuenta ni la contraseña de la base.

# demo (por defecto): todo en este navegador con datos ficticios · qa: base QA compartida con Pie Firme
VITE_MODO=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DB_SCHEMA=

# --- WhatsApp Cloud API (Meta): solo para la demo con WhatsApp real. Valores SOLO en Netlify o aqui, nunca en el fuente ---
VITE_WHATSAPP_REAL=0
WA_TOKEN=
WA_PHONE_ID=
WA_DESTINATARIOS=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
