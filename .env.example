# ─────────────────────────────────────────────────────────────────────────────
# .env.example — SOLO NOMBRES. Los valores van en .env.local (gitignored).
# Los scripts de scripts/ leen de aquí; nada de refs ni hosts incrustados.
#
# Convención (la misma en todos los proyectos RANNIX):
#   QA_*      → ambiente de pruebas      (sitio Netlify de la rama develop)
#   (sin pfx) → PRODUCCIÓN               (sitio Netlify de la rama master)
#   VITE_*    → lo único que ve el navegador. En el fuente SIEMPRE apunta a QA.
#   NEW_/DEMO_… → cualquier ambiente extra: prefijo en mayúsculas + "_".
#
# `node scripts/supabase-api.mjs crear qa|prod` llena casi todo esto solo.
# ─────────────────────────────────────────────────────────────────────────────

PROYECTO=                       # slug corto: ej. petra-condominios

# ── Cuenta (una vez en la vida: variables de USUARIO de Windows, no aquí) ────
# SUPABASE_ACCESS_TOKEN=sbp_…   # Personal Access Token de Supabase
# NETLIFY_AUTH_TOKEN=nfp_…      # Personal Access Token de Netlify
# (gh se autentica con `gh auth login`)

# ── Navegador (público) — apunta a QA en el fuente ───────────────────────────
VITE_AMBIENTE=QA
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DB_SCHEMA=piefirme         # esquema de Pie Firme dentro de la base compartida BITDATA
DB_SCHEMA=piefirme              # igual, para funciones de servidor
DUMP_SCHEMAS=piefirme,piefirme_app

# ── QA ───────────────────────────────────────────────────────────────────────
QA_SUPABASE_REF=
QA_SUPABASE_URL=
QA_SUPABASE_ANON_KEY=
QA_SUPABASE_SERVICE_ROLE_KEY=   # solo servidor / scripts
QA_SUPABASE_DB_PASSWORD=
# Opcionales (default: db.<ref>.supabase.co / postgres). Si la red es IPv4,
# usar el pooler: host aws-0-<región>.pooler.supabase.com, user postgres.<ref>
QA_SUPABASE_DB_HOST=
QA_SUPABASE_DB_USER=
QA_SITE_URL=                    # https://<proyecto>-qa.netlify.app
QA_NETLIFY_SITE_ID=

# ── PRODUCCIÓN — NUNCA a git, nunca en el fuente ─────────────────────────────
SUPABASE_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # jamás sale del lado servidor
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SITE_URL=                       # https://<dominio-real>
NETLIFY_SITE_ID=

# ── Solo en variables de Netlify (nunca VITE_*, nunca .env.local) ────────────
# ANTHROPIC_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Opcionales ───────────────────────────────────────────────────────────────
DUMP_SCHEMAS=public             # esquemas a volcar/clonar, separados por coma
